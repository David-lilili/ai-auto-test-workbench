# Never commit real secrets. Copy this file to .env and fill in your values.
# .env 已在 .gitignore 中，服务器启动时自动加载（不覆盖已存在的系统环境变量）。
#
# AI Provider 配置（环境变量优先于 storage/ai-settings.json）：
# 接入 GLM 腾讯部署只需取消下面三行注释并填值，然后重启服务
# （npm run workbench:stop && npm run workbench:watchdog）。
#
#GLM_API_KEY=sk-your-glm-key
#GLM_MODEL=glm-5.3-tencent
#GLM_BASE_URL=https://你的腾讯部署地址/v1
#
# 切换 provider 时显式声明（不设则用 storage/ai-settings.json 里的 provider，缺省 deepseek）：
#AI_PROVIDER=glm
#
# DeepSeek（缺省 provider）与 OpenAI 兼容：
#DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=
#DEEPSEEK_BASE_URL=
#OPENAI_API_KEY=
#OPENAI_MODEL=
#OPENAI_BASE_URL=
TEST_ACCOUNT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
