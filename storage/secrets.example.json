{
  "redis": {
    "demo": {
      "test": {
        "spot": {
          "host": "<REDIS_HOST>",
          "port": 6379,
          "passwordRef": "env:<REDIS_PASSWORD_ENV_NAME>"
        }
      }
    }
  },
  "keepassxc": {
    "demo": {
      "test": {
        "cliPath": "<KEEPASSXC_CLI_PATH>",
        "databasePath": "<KEEPASSXC_DATABASE_PATH>",
        "databasePasswordRef": "env:<KEEPASSXC_DATABASE_PASSWORD_ENV_NAME>",
        "entries": {
          "<TEST_USERNAME>": {
            "type": "totp",
            "provider": "keepassxc",
            "entry": "<TOTP_ENTRY_NAME>"
          }
        }
      }
    }
  },
  "tokens": {
    "demo": {
      "test": {
        "apiTokenRef": "env:<TOKEN_FROM_ENV>"
      }
    }
  }
}
